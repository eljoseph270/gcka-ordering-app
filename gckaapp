# ------------------------------------------------------------------------------

def calculate_totals(cart_items, promo_code="", tax_rate=0.07):
    """
    Demonstrates Good Variable Scope:
    Keeps calculation variables (subtotal, discount, tax) contained 
    inside the function scope and returns only the finalized results.
    """
    # Local scope calculation variables
    raw_subtotal = sum(item["price"] * item["qty"] for item in cart_items)
    
    # Calculate discount
    discount_rate = 0.10 if promo_code.upper() == "GCKA10" else 0.00
    discount_amount = raw_subtotal * discount_rate
    
    discounted_subtotal = raw_subtotal - discount_amount
    tax_amount = discounted_subtotal * tax_rate
    grand_total = discounted_subtotal + tax_amount

    return {
        "subtotal": round(raw_subtotal, 2),
        "discount": round(discount_amount, 2),
        "tax": round(tax_amount, 2),
        "total": round(grand_total, 2)
    }

def filter_catalog(catalog, selected_category, max_price, selected_flavor, selected_dietary):
    """Filters products dynamically based on search controls."""
    filtered = {}
    for p_id, item in catalog.items():
        cat_match = (selected_category == "All") or (item["category"] == selected_category)
        price_match = item["price"] <= max_price
        flavor_match = (selected_flavor == "All") or (item["flavor"] == selected_flavor)
        dietary_match = (selected_dietary == "All") or (item["dietary"] == selected_dietary)
        
        if cat_match and price_match and flavor_match and dietary_match:
            filtered[p_id] = item
    return filtered

def validate_checkout_info(name, email, phone):
    """Intelligent Checkout Validation."""
    errors = []
    if len(name.strip()) < 2:
        errors.append("Please enter a valid full name.")
    if "@" not in email or "." not in email:
        errors.append("Please enter a valid email address.")
    if len(phone.replace("-", "").strip()) < 10:
        errors.append("Please enter a valid 10-digit phone number.")
    return len(errors) == 0, errors


